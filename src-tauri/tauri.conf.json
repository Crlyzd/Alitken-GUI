{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Alitken",
  "version": "0.4.0",
  "identifier": "com.alitken.mediaconverter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ALITKEN v0.4",
        "width": 980,
        "height": 700,
        "minWidth": 840,
        "minHeight": 580,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
